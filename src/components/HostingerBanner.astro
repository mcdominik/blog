---
import { HOSTINGER_PROMO } from "../config.ts";

const { url, code } = HOSTINGER_PROMO;
// Repeated so the strip is wider than any screen; the second half is a visual copy for the seamless loop.
const items = Array.from({ length: 6 });
---

<a
  href={url}
  target="_blank"
  rel="sponsored noopener"
  class="hostinger-banner group block overflow-hidden mt-2 sm:mt-0 rounded-xl shadow-sm shadow-[#673DE6]/30 bg-gradient-to-r from-[#673DE6] via-[#8C6CF0] to-[#673DE6] text-white text-xs sm:text-sm font-medium"
  aria-label={`Need reliable hosting? Get 10% off Hostinger with code ${code}`}
>
  <div class="marquee flex w-max" aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="flex shrink-0">
          {items.map(() => (
            <span class="flex items-center gap-x-2 px-6 py-2 whitespace-nowrap">
              <span>Need reliable hosting?</span>
              <span class="opacity-80">10% off with code</span>
              <span class="rounded-md bg-white/15 ring-1 ring-white/30 px-1.5 py-0.5 font-mono font-bold tracking-wide group-hover:bg-white group-hover:text-[#673DE6] transition-colors">
                {code}
              </span>
              <span class="opacity-60">·</span>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16.415 0v7.16l5.785 3.384V2.949L16.415 0ZM1.8 0v11.237h18.815L14.89 8.09l-7.457-.003V3.024L1.8 0Zm14.615 20.894v-5.019l-7.514-.005c.007.033-5.82-3.197-5.82-3.197l19.119.091V24l-5.785-3.106ZM1.8 13.551v7.343l5.633 2.949v-6.988L1.8 13.551Z" />
              </svg>
              <span class="font-bold tracking-tight">Hostinger</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</a>

<style>
  .marquee {
    animation: marquee 60s linear infinite;
  }
  .hostinger-banner:hover .marquee,
  .hostinger-banner:focus-visible .marquee {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
  }
</style>
