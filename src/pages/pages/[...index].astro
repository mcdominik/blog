---
import { POSTS_PER_PAGE } from "../../config.ts";
import { getBlogPosts } from "src/utils";
import PostList from "$layouts/PostList.astro";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const total = Math.ceil(posts.length / POSTS_PER_PAGE);
  if (total <= 1) return [];

  // Start from page 2 since page 1 is served at "/"
  return Array.from({ length: total - 1 }).map((_, index) => ({
    params: { index: (index + 2).toString() },
    props: { index: index + 2 },
  }));
}

const { index } = Astro.props;

const posts = (await getBlogPosts()).splice(
  POSTS_PER_PAGE * (index - 1),
  POSTS_PER_PAGE
);
const total = Math.ceil((await getBlogPosts()).length / POSTS_PER_PAGE);
---

<PostList
  {posts}
  totalPages={total}
  currentPage={index}
  showFeatured={false}
>
  <h1>
    All blog posts
    {total > 0 ? ` - Page ${index}` : ""}
  </h1>
</PostList>
